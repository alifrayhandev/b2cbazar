# Copy this file to .env and set unique production values.
PORT=3000
NODE_ENV=development
SITE_NAME=B2C Bazar
PUBLIC_SITE_URL=http://localhost:3000
# Generate a long random value (at least 32 characters)
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Set a strong password before first run. Admin username is ADMIN_USERNAME.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
# Local DB path. On Render, use a mounted persistent disk path such as /var/data/b2c-bazar.sqlite
DATABASE_PATH=./data/b2c-bazar.sqlite
# Optional: order notification email is a future integration; not sent by this app.
